# Copy this file to .env. Every value is OPTIONAL: Coin Buddy works with no keys at all.

# Reddit API (free). Without these, Coin Buddy reads Reddit's public JSON feed instead.
# Create a "script" app at https://www.reddit.com/prefs/apps and install the extra: pip install -e ".[reddit]"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=coin-buddy/2.0 by your_reddit_username

# Discord alerts (free). Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Exchange API keys are NOT needed: market data comes from public endpoints via ccxt.
